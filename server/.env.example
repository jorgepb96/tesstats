# --- MQTT (same broker TeslaMate uses) ---
# Inside the same docker network you can talk to mosquitto directly (no TLS needed):
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=tesstats
MQTT_PASSWORD=change-me
# If instead you reach it over wss behind a reverse proxy with Basic Auth:
# MQTT_URL=wss://teslamqtt.example.com/
# MQTT_BASIC_AUTH=user:pass
# If that hostname is protected by Cloudflare Access, add a service token
# (Zero Trust → Access → Service credentials). Also sent to HISTORY_API_URL.
# CF_ACCESS_CLIENT_ID=xxxxxxxx.access
# CF_ACCESS_CLIENT_SECRET=
TOPIC_ROOT=teslamate/cars

# --- HTTP (device-token registration endpoint) ---
PORT=8090
# Shared secret the app must include when registering its push token (recommended).
REGISTER_TOKEN=choose-a-long-random-string

# --- APNs (Apple Push Notification service) ---
# Optional: omit all APNS_* entries and the key mount for ntfy/webhook-only setups.
# Create an APNs Auth Key (.p8) in the Apple Developer portal (Keys → +, enable APNs).
# APNS_KEY_PATH=/keys/AuthKey_ABCDE12345.p8
# APNS_KEY_ID=ABCDE12345
# APNS_TEAM_ID=YOURTEAMID
# APNS_BUNDLE_ID=com.tesstats.app
# false = sandbox (development builds), true = production (TestFlight/App Store)
# APNS_PRODUCTION=true

# --- ntfy (recommended for sideloaded / AltStore installs) ---
# Sideloaded apps are signed without the push entitlement, so APNs can never reach
# them. Install the ntfy app (ntfy.sh), subscribe to a topic, and set these instead:
# No registration or Immediate push toggle in Tesstats is needed for ntfy delivery.
# NTFY_URL=https://ntfy.sh            # or your self-hosted ntfy
# NTFY_TOPIC=my-secret-tesstats-topic # treat the topic name as a password
# NTFY_TOKEN=                          # optional Bearer token (self-hosted auth)

# --- Generic webhook (Home Assistant, Node-RED, ...) ---
# POSTs {"title","body","carId","event","ts"} JSON per event, so you can chain
# automations: sirens, lights, Telegram — whatever your home can do.
# WEBHOOK_URL=https://ha.example.com/api/webhook/tesstats-sentry

# --- Which events trigger an immediate push ---
NOTIFY_SENTRY=true
NOTIFY_UNLOCKED=true
NOTIFY_OPENINGS=true
# Suppress repeat Sentry banners from the same incident (seconds)
SENTRY_COOLDOWN_SEC=600
# Optional: TeslaMateAPI base URL for charge-cost reminders while iPhone is asleep.
# Keep this private to the same operator/vehicles as the MQTT bridge.
HISTORY_API_URL=
HISTORY_API_AUTHORIZATION=
CHARGE_REMINDERS_FILE=./charge-reminders.json
