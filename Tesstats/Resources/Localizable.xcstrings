    "Uses stable Bluetooth telemetry when available, then changes to iPhone GPS and TeslaMate without rapid source switching." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Uses stable Bluetooth telemetry when available, then changes to iPhone GPS and TeslaMate without rapid source switching." } },
