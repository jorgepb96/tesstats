          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisos locales en el dispositivo. iOS no puede sondear 24/7 en segundo plano de forma fiable; para avisos garantizados con la app cerrada, ejecuta el microservicio de push opcional (ver README)."
          }
        }
      }
    },
