    },
    "Uses the vehicle Bluetooth speed only. The map still follows this iPhone because Bluetooth does not provide vehicle location." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Uses the vehicle Bluetooth speed only. The map still follows this iPhone because Bluetooth does not provide vehicle location." } },
