    "Local monitoring stops when iOS suspends the app. Configure Immediate push below for reliable locked-screen alerts." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local monitoring stops when iOS suspends the app. Configure Immediate push below for reliable locked-screen alerts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La monitorización local se detiene cuando iOS suspende la app. Configura Push inmediato abajo para recibir alertas fiables con la pantalla bloqueada."
          }
        }
      }
    },
    "The local test is scheduled 10 seconds later: lock the iPhone after tapping it to verify Lock Screen permission. Vehicle alerts need the optional push service below once iOS suspends the app." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local test is scheduled 10 seconds later: lock the iPhone after tapping it to verify Lock Screen permission. Vehicle alerts need the optional push service below once iOS suspends the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba local se programa 10 segundos después: bloquea el iPhone tras pulsarla para verificar el permiso de la pantalla bloqueada. Las alertas del vehículo necesitan el servicio push opcional cuando iOS suspende la app."
          }
        }
      }
    },
