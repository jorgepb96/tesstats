    "Price bands by time of day (bands may cross midnight, e.g. 22:00–06:00). Hours outside every band use the default charge price. Sessions are priced by how much of their duration falls in each band. Swipe a band to delete it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Price bands by time of day (bands may cross midnight, e.g. 22:00–06:00). Hours outside every band use the default charge price. Sessions are priced by how much of their duration falls in each band. Swipe a band to delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Franjas de precio por hora del día (pueden cruzar la medianoche, p. ej. 22:00–06:00). Las horas fuera de todas las franjas usan el precio por defecto. Cada sesión se valora según cuánto de su duración cae en cada franja. Desliza una franja para eliminarla."
          }
        }
      }
    },
    "Price per kWh" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Price per kWh"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precio por kWh"
          }
        }
      }
    },
    "Price you pay per kWh at %@. Used to estimate cost when TeslaMate has none. Leave empty to use the default (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Price you pay per kWh at %@. Used to estimate cost when TeslaMate has none. Leave empty to use the default (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precio que pagas por kWh en %@. Se usa para estimar el coste cuando TeslaMate no lo registra. Déjalo vacío para usar el predeterminado (%@)."
          }
        }
      }
    },
