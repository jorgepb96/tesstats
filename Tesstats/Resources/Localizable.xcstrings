        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set when each band starts — the app closes the day automatically, so the bands always add up to 24 hours. Leave the sell price empty to match the buy price. Swipe a band to delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica cuándo empieza cada tramo: la app cierra el día automáticamente, así que los tramos siempre suman 24 horas. Deja el precio de venta vacío para igualarlo al de compra. Desliza un tramo para eliminarlo."
          }
        }
      }
    },
